# Root .gitignore for Aeronex monorepo

# Node and package manager
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files / secrets
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
.vite/
coverage/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Backend-specific
/Backend/node_modules/
/Backend/dist/
/Backend/.env
/Backend/*.sqlite
/Backend/logs/

# Frontend-specific
/Frontend/node_modules/
/Frontend/dist/
/Frontend/build/
/Frontend/.vite/
/Frontend/.cache/
/Frontend/.env

# Optional: lockfiles are usually committed, but ignore if you don't want them
# package-lock.json
